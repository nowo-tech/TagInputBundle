{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Tag FormType demos',
        intro: 'Tagify-powered text inputs mapped to Symfony form data (array or comma-separated string).',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Examples', intro: 'Each example is one tag field with its own options.', kind: 'table'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <tbody>
                    {% for slug, cfg in examples %}
                        <tr>
                            <td class="nowo-ui-cell--wrap">
                                <a class="nowo-ui-link" href="{{ path('app_demo_tags', { slug: slug }) }}">{{ cfg.title }}</a>
                                <div class="nowo-ui-muted">{{ cfg.help }}</div>
                            </td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ slug }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
