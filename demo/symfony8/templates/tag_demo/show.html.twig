{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: demo_title,
        intro: 'Tagify UI on a single text field.',
    }) }}
{% endblock %}

{% block body %}
    {% if submitted_value is not null %}
        <div class="nowo-ui-flash nowo-ui-flash--success" role="alert">
            Submitted value:
            {% if submitted_value is iterable %}
                <code class="nowo-ui-code">{{ submitted_value|json_encode }}</code>
            {% else %}
                <code class="nowo-ui-code">{{ submitted_value }}</code>
            {% endif %}
        </div>
    {% endif %}

    {% set _items = [{ label: 'All demos', href: path('app_demo_index') }] %}
    {% for slug, cfg in examples %}
        {% set _items = _items|merge([{ label: cfg.title, href: path('app_demo_tags', { slug: slug }), current: slug == demo_slug }]) %}
    {% endfor %}
    {{ include(nowo_ui_partial('tabs'), { items: _items, aria_label: 'Tag examples' }) }}

    <section class="nowo-ui-card" data-testid="demo-case">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
                {# REQ-TWIG-003: child loop #}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        </div>
    </section>

    <link rel="stylesheet" href="{{ asset('tag-input.css', 'nowo_tag_input') }}">
    <script src="{{ asset('tag-input.js', 'nowo_tag_input') }}"></script>
{% endblock %}
