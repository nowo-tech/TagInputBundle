{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('app_demo_index') }}">All demos</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: demo_title,
        intro: 'Tagify UI on a single text field.',
        toolbar: _toolbar|trim,
    }) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {% set _submitted = submitted_value is iterable ? submitted_value|json_encode : submitted_value %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: submitted_value is not null ? {success: ['Submitted value: ' ~ _submitted]} : null}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: demo_title, kind: 'form', testid: 'demo-case'} %}
        {% block section_body %}
            {{ form_start(form, { attr: { id: 'demo-form', class: 'nowo-ui-form', novalidate: 'novalidate' } }) }}
                {# REQ-TWIG-003: child loop #}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {% do form.submit.setRendered %}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
